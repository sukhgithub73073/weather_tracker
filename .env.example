# Copy this file to `.env` and fill in your OpenWeatherMap API key.
# Get a key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_api_key_here

# Optional overrides
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# Set to true if your key has One Call 3.0 access (hourly/daily/UV/alerts in one request).
# When false the app falls back to the free Current Weather + 5 day / 3 hour Forecast endpoints.
OPENWEATHER_USE_ONE_CALL=false
